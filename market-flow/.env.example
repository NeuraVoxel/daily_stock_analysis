MARKET_FLOW_UI_PORT=8080
MARKET_FLOW_API_PORT=8001

CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173

FLOW_TOP_N=10
FLOW_TOP_M=10
CACHE_TTL_REALTIME_SEC=45
CACHE_TTL_DAY_SEC=600
CACHE_TTL_LONG_SEC=3600
UPSTREAM_TIMEOUT_SEC=20
